<?xml version="1.0" encoding="UTF-8"?>
<!--
    Connect IQ manifest for the RuuviSensor data field.
    - type="datafield"     : SimpleDataField application
    - minApiLevel="3.2.0"  : BluetoothLowEnergy + Application.Properties
    - BluetoothLowEnergy permission is mandatory for Toybox.BluetoothLowEnergy
-->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="fa6a15ae8e004ab197061da1619b091a"
                    type="datafield"
                    name="@Strings.AppName"
                    entry="EnvSensorApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="montana7xx"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="BluetoothLowEnergy"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
